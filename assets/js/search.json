---
layout: null
sitemap: false
---
[{% for p in site.posts %}{"t":{{ p.title | jsonify }},"u":{{ p.url | relative_url | jsonify }},"d":{{ p.date | date: "%Y-%m-%d" | jsonify }},"c":{{ p.categories | jsonify }},"g":{{ p.tags | jsonify }},"s":{{ p.description | default: "" | jsonify }},"x":{{ p.content | strip_html | strip_newlines | truncatewords: 900, "" | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
