stage "Checking inputs"
python3 - << 'EOF'
import json, sys
for fname in ["inputs/materials_db.json", "inputs/rf_bands.json"]:
    try:
        with open(fname, 'r') as f:
            data = json.load(f)
    except Exception as e:
        print(f"Error reading {fname}: {e}")
        sys.exit(3)

with open("inputs/materials_db.json") as f:
    mat_data = json.load(f)
with open("inputs/rf_bands.json") as f:
    band_data = json.load(f)

mats = mat_data.get("materials", [])
bands = band_data.get("bands", [])

if len(mats) < 5:
    print(f"Insufficient material records: {len(mats)} found, expected >= 5")
    sys.exit(3)
if len(bands) < 4:
    print(f"Insufficient band records: {len(bands)} found, expected >= 4")
    sys.exit(3)

for m in mats:
    if m.get("sigma", 0) <= 0 or m.get("thickness_m", 0) <= 0:
        print(f"Invalid material properties for {m.get('name')}")
        sys.exit(3)

print(f"inputs OK: {len(mats)} shielding materials verified, {len(bands)} RF bands loaded.")
EOF

stage "Running"
python3 - << 'EOF'
import json, os, cmath
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import skrf as rf

# Constants
MU_0 = 4.0 * np.pi * 1e-7   # H/m
EPS_0 = 8.8541878128e-12    # F/m
C_0 = 1.0 / np.sqrt(MU_0 * EPS_0)
ETA_0 = np.sqrt(MU_0 / EPS_0) # ~376.73 Ohms

# Parameters from environment
f_start = float(os.getenv("PARAM_FREQ_START_HZ", 1e4))
f_stop = float(os.getenv("PARAM_FREQ_STOP_HZ", 1e10))
n_pts = int(os.getenv("PARAM_NUM_FREQ_POINTS", 500))
r_dist = float(os.getenv("PARAM_NEAR_FIELD_DIST_M", 0.3))
aperture_l = float(os.getenv("PARAM_APERTURE_LENGTH_M", 0.15))

freqs = np.logspace(np.log10(f_start), np.log10(f_stop), n_pts)
omega = 2.0 * np.pi * freqs

with open("inputs/materials_db.json") as f:
    mat_db = json.load(f)
with open("inputs/rf_bands.json") as f:
    bands_db = json.load(f)

materials = mat_db["materials"]
results_dict = {"freq_hz": freqs}

summary_records = []

for mat in materials:
    mid = mat["id"]
    mname = mat["name"]
    sigma = mat["sigma"]
    mu_r = mat["mu_r"]
    eps_r = mat["eps_r"]
    t = mat["thickness_m"]
    
    mu = MU_0 * mu_r
    eps_c = EPS_0 * eps_r - 1j * (sigma / omega)
    
    # Intrinsic impedance and propagation constant
    gamma = 1j * omega * np.sqrt(mu * eps_c)
    eta = np.sqrt(mu / eps_c)
    
    # Skin depth
    # delta = 1 / Re(gamma)
    skin_depth = 1.0 / np.real(gamma)
    
    # Schelkunoff terms for far-field plane wave
    # Absorption loss A (dB)
    A = 20.0 * np.log10(np.exp(1.0)) * (t / skin_depth)
    
    # Reflection loss R (dB)
    # R = 20 log10 | (eta0 + eta)^2 / (4 * eta0 * eta) |
    R_far = 20.0 * np.log10(np.abs((ETA_0 + eta)**2 / (4.0 * ETA_0 * eta)))
    
    # Multiple reflection correction B (dB)
    refl_coeff = (eta - ETA_0) / (eta + ETA_0)
    B = 20.0 * np.log10(np.maximum(1e-15, np.abs(1.0 - (refl_coeff**2) * np.exp(-2.0 * gamma * t))))
    
    SE_plane = np.maximum(0.0, A + R_far + B)
    
    # Near-field wave impedance at distance r_dist
    # Magnetic dipole source (loop): Zw_H = omega * mu_0 * r
    # Electric dipole source (rod): Zw_E = 1 / (omega * eps_0 * r)
    Zw_H = omega * MU_0 * r_dist
    Zw_E = 1.0 / (omega * EPS_0 * r_dist)
    
    R_H = 20.0 * np.log10(np.maximum(1e-15, np.abs((Zw_H + eta)**2 / (4.0 * Zw_H * eta))))
    R_E = 20.0 * np.log10(np.maximum(1e-15, np.abs((Zw_E + eta)**2 / (4.0 * Zw_E * eta))))
    
    SE_H = np.maximum(0.0, A + R_H + B)
    SE_E = np.maximum(0.0, A + R_E + B)
    
    # Aperture degradation (Bethe/Ott slot diffraction model)
    # SE_slot = 20 log10(lambda / (2 * L)), bounded below at 0 dB
    wavelength = C_0 / freqs
    SE_slot = np.maximum(0.0, 20.0 * np.log10(np.maximum(1e-10, wavelength / (2.0 * aperture_l))))
    
    # Enclosure isolation with slot leakage
    # Total leakage is power sum: 10^(-SE_eff/10) = 10^(-SE_mat/10) + 10^(-SE_slot/10)
    leakage_mat = 10.0 ** (-SE_plane / 10.0)
    leakage_slot = 10.0 ** (-SE_slot / 10.0)
    SE_effective = -10.0 * np.log10(leakage_mat + leakage_slot)
    SE_effective = np.clip(SE_effective, 0.0, 160.0)
    
    results_dict[f"{mid}_A_dB"] = A
    results_dict[f"{mid}_R_dB"] = R_far
    results_dict[f"{mid}_SE_plane_dB"] = SE_plane
    results_dict[f"{mid}_SE_H_dB"] = SE_H
    results_dict[f"{mid}_SE_E_dB"] = SE_E
    results_dict[f"{mid}_SE_eff_aperture_dB"] = SE_effective
    results_dict[f"{mid}_skindepth_m"] = skin_depth
    
    summary_records.append({
        "material_id": mid,
        "material_name": mname,
        "thickness_mm": t * 1000,
        "sigma_Sm": sigma,
        "mu_r": mu_r,
        "se_hf_30mhz_plane_db": float(np.interp(3e7, freqs, SE_plane)),
        "se_vhf_150mhz_plane_db": float(np.interp(1.5e8, freqs, SE_plane)),
        "se_uhf_800mhz_plane_db": float(np.interp(8e8, freqs, SE_plane)),
        "se_wifi_2.4ghz_plane_db": float(np.interp(2.4e9, freqs, SE_plane)),
        "se_hf_30mhz_H_field_db": float(np.interp(3e7, freqs, SE_H)),
        "se_lowf_100khz_H_field_db": float(np.interp(1e5, freqs, SE_H)),
        "se_uhf_aperture_degraded_db": float(np.interp(8e8, freqs, SE_effective))
    })

# Multilayer Composite RV Wall TMM Calculation
composite = mat_db["composites"][0]
comp_layers = composite["layers"]

# Characteristic matrix multiplication across layers for normal incidence
T_comp = np.zeros(n_pts, dtype=complex)
for idx, f in enumerate(freqs):
    w = 2.0 * np.pi * f
    M_tot = np.identity(2, dtype=complex)
    for layer in comp_layers:
        sig_l = layer["sigma"]
        mu_l = MU_0 * layer["mu_r"]
        eps_l = EPS_0 * layer["eps_r"] - 1j * (sig_l / w)
        d_l = layer["thickness_m"]
        k_l = w * np.sqrt(mu_l * eps_l)
        eta_l = np.sqrt(mu_l / eps_l)
        
        m11 = np.cos(k_l * d_l)
        m12 = 1j * eta_l * np.sin(k_l * d_l)
        m21 = 1j * (1.0 / eta_l) * np.sin(k_l * d_l)
        m22 = np.cos(k_l * d_l)
        M_layer = np.array([[m11, m12], [m21, m22]], dtype=complex)
        M_tot = np.dot(M_tot, M_layer)
    
    # Transmission coefficient T from free-space to free-space
    A_elem = M_tot[0, 0]
    B_elem = M_tot[0, 1]
    C_elem = M_tot[1, 0]
    D_elem = M_tot[1, 1]
    t_coeff = 2.0 / (A_elem + B_elem / ETA_0 + C_elem * ETA_0 + D_elem)
    T_comp[idx] = t_coeff

SE_composite_dB = -20.0 * np.log10(np.maximum(1e-15, np.abs(T_comp)))
results_dict["rv_wall_composite_SE_plane_dB"] = SE_composite_dB

df_all = pd.DataFrame(results_dict)
df_all.to_csv("outputs/rf_shielding_effectiveness_summary.csv", index=False)

df_summary = pd.DataFrame(summary_records)
df_summary.to_csv("outputs/rf_shielding_by_band.csv", index=False)

# Export Touchstone 2-port network using scikit-rf for the composite wall
skrf_freq = rf.Frequency(f_start / 1e6, f_stop / 1e6, n_pts, 'mhz')
# Construct 2-port S-parameters
# S21 = T, S11 = reflected
s_matrix = np.zeros((n_pts, 2, 2), dtype=complex)
s_matrix[:, 1, 0] = T_comp
s_matrix[:, 0, 1] = T_comp
# By energy conservation / transmission line relation:
r_comp = np.sqrt(np.maximum(0.0, 1.0 - np.abs(T_comp)**2))
s_matrix[:, 0, 0] = r_comp
s_matrix[:, 1, 1] = r_comp

ntwk = rf.Network(frequency=skrf_freq, s=s_matrix, name="RV_Wall_Composite_Shield")
ntwk.write_touchstone("outputs/rv_wall_shielding.s2p")

# Band aggregate performance analysis
band_eval = []
for b in bands_db["bands"]:
    b_name = b["name"]
    b_fmin = b["f_min"]
    b_fmax = b["f_max"]
    mask = (freqs >= b_fmin) & (freqs <= b_fmax)
    if np.any(mask):
        band_record = {"band": b_name, "f_center_mhz": np.sqrt(b_fmin * b_fmax) / 1e6}
        for mat in materials:
            mid = mat["id"]
            mean_se = float(np.mean(df_all[f"{mid}_SE_plane_dB"][mask]))
            mean_se_h = float(np.mean(df_all[f"{mid}_SE_H_dB"][mask]))
            band_record[f"{mid}_SE_plane_avg"] = round(mean_se, 1)
            band_record[f"{mid}_SE_H_avg"] = round(mean_se_h, 1)
        band_record["composite_wall_SE_avg"] = round(float(np.mean(SE_composite_dB[mask])), 1)
        band_eval.append(band_record)

with open("outputs/isolation_report.json", "w") as f:
    json.dump({"summary": summary_records, "band_analysis": band_eval}, f, indent=2)

print("Core EM computations and Touchstone files successfully generated.")
EOF

stage "Post-processing"
python3 - << 'EOF'
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

df = pd.read_csv("outputs/rf_shielding_effectiveness_summary.csv")
freqs_mhz = df["freq_hz"] / 1e6

# Plot 1: Far-field Plane Wave Shielding Effectiveness
plt.figure(figsize=(10, 6))
plt.plot(freqs_mhz, np.clip(df["aluminum_6061_1mm_SE_plane_dB"], 0, 200), label="Aluminum 6061 (1.0 mm)", lw=2)
plt.plot(freqs_mhz, np.clip(df["copper_sheet_0.5mm_SE_plane_dB"], 0, 200), label="Copper Sheet (0.5 mm)", lw=2)
plt.plot(freqs_mhz, np.clip(df["galvanized_steel_0.8mm_SE_plane_dB"], 0, 200), label="Galvanized Steel (0.8 mm)", lw=2)
plt.plot(freqs_mhz, np.clip(df["stainless_steel_304_SE_plane_dB"], 0, 200), label="Stainless Steel 304 (0.8 mm)", lw=2)
plt.plot(freqs_mhz, np.clip(df["conductive_fabric_nicu_SE_plane_dB"], 0, 200), label="Ni/Cu Fabric (0.08 mm)", lw=2, linestyle="--")
plt.plot(freqs_mhz, np.clip(df["low_e_mylar_film_SE_plane_dB"], 0, 200), label="Low-E Mylar Film (50 nm)", lw=2, linestyle=":")
plt.plot(freqs_mhz, np.clip(df["rv_wall_composite_SE_plane_dB"], 0, 200), label="RV Composite Wall", lw=2.5, color="black")

plt.xscale("log")
plt.ylim(0, 200)
plt.xlabel("Frequency (MHz)", fontsize=12)
plt.ylabel("Shielding Effectiveness SE (dB)", fontsize=12)
plt.title("Far-Field (Plane Wave) RF Shielding Effectiveness Across Materials", fontsize=13)
plt.grid(True, which="both", ls="--", alpha=0.5)
plt.axvline(x=30, color="gray", linestyle=":", label="HF/VHF (30 MHz)")
plt.axvline(x=800, color="orange", linestyle=":", label="Cellular/UHF (800 MHz)")
plt.axvline(x=2400, color="red", linestyle=":", label="Wi-Fi (2.4 GHz)")
plt.legend(loc="upper left", fontsize=9)
plt.tight_layout()
plt.savefig("outputs/rf_materials_se_farfield.png", dpi=300)
plt.close()

# Plot 2: Near-field Magnetic Field (H-Field) Shielding (The critical vehicle challenge)
plt.figure(figsize=(10, 6))
plt.plot(freqs_mhz, np.clip(df["mumetal_0.5mm_SE_H_dB"], 0, 160), label="Mu-Metal (0.5 mm, mu_r=20000)", lw=2.5, color="darkviolet")
plt.plot(freqs_mhz, np.clip(df["galvanized_steel_0.8mm_SE_H_dB"], 0, 160), label="Galvanized Steel (0.8 mm, mu_r=200)", lw=2, color="brown")
plt.plot(freqs_mhz, np.clip(df["aluminum_6061_1mm_SE_H_dB"], 0, 160), label="Aluminum 6061 (1.0 mm)", lw=2, color="blue")
plt.plot(freqs_mhz, np.clip(df["copper_sheet_0.5mm_SE_H_dB"], 0, 160), label="Copper Sheet (0.5 mm)", lw=2, color="red")
plt.plot(freqs_mhz, np.clip(df["conductive_fabric_nicu_SE_H_dB"], 0, 160), label="Ni/Cu Fabric (0.08 mm)", lw=2, linestyle="--", color="green")

plt.xscale("log")
plt.ylim(0, 160)
plt.xlabel("Frequency (MHz)", fontsize=12)
plt.ylabel("Near-Field H-Field Isolation SE_H (dB, r=0.3m)", fontsize=12)
plt.title("Near-Field Magnetic Shielding: Permeable Steel/Mu-Metal vs Non-Magnetic Conductors", fontsize=13)
plt.grid(True, which="both", ls="--", alpha=0.5)
plt.legend(loc="upper left", fontsize=9)
plt.tight_layout()
plt.savefig("outputs/rf_materials_se_nearfield_H.png", dpi=300)
plt.close()

# Plot 3: Absorption Loss vs Reflection Loss Breakdown
plt.figure(figsize=(10, 6))
plt.plot(freqs_mhz, df["aluminum_6061_1mm_A_dB"], label="Aluminum Absorption Loss (A)", lw=2, color="navy")
plt.plot(freqs_mhz, df["aluminum_6061_1mm_R_dB"], label="Aluminum Reflection Loss (R)", lw=2, linestyle="--", color="cornflowerblue")
plt.plot(freqs_mhz, df["galvanized_steel_0.8mm_A_dB"], label="Steel Absorption Loss (A)", lw=2, color="darkred")
plt.plot(freqs_mhz, df["galvanized_steel_0.8mm_R_dB"], label="Steel Reflection Loss (R)", lw=2, linestyle="--", color="salmon")

plt.xscale("log")
plt.ylim(0, 200)
plt.xlabel("Frequency (MHz)", fontsize=12)
plt.ylabel("Loss Component (dB)", fontsize=12)
plt.title("Schelkunoff Decomposition: Absorption (A) vs Reflection (R) Mechanisms", fontsize=13)
plt.grid(True, which="both", ls="--", alpha=0.5)
plt.legend(loc="upper left", fontsize=9)
plt.tight_layout()
plt.savefig("outputs/rf_materials_absorption_vs_reflection.png", dpi=300)
plt.close()

# Plot 4: Material Isolation vs Aperture Degradation (Door seams / vent slots)
plt.figure(figsize=(10, 6))
plt.plot(freqs_mhz, np.clip(df["aluminum_6061_1mm_SE_plane_dB"], 0, 160), label="Solid Aluminum Sheet (Theoretical)", lw=2.5, color="blue")
plt.plot(freqs_mhz, df["aluminum_6061_1mm_SE_eff_aperture_dB"], label="Aluminum with 15cm Unshielded Seam (Effective)", lw=2.5, color="crimson", linestyle="-.")
plt.plot(freqs_mhz, np.clip(df["conductive_fabric_nicu_SE_plane_dB"], 0, 160), label="Continuous Ni/Cu Gasketed Fabric", lw=2, color="green")
plt.plot(freqs_mhz, df["conductive_fabric_nicu_SE_eff_aperture_dB"], label="Ni/Cu Fabric with 15cm Seam Gap", lw=2, color="orange", linestyle="-.")

plt.xscale("log")
plt.ylim(0, 160)
plt.xlabel("Frequency (MHz)", fontsize=12)
plt.ylabel("Effective Shielding Effectiveness (dB)", fontsize=12)
plt.title("Impact of Apertures/Seams on Mobile Shelter Isolation (Bethe/Ott Model)", fontsize=13)
plt.grid(True, which="both", ls="--", alpha=0.5)
plt.legend(loc="upper right", fontsize=9)
plt.tight_layout()
plt.savefig("outputs/rf_composite_vs_aperture_degradation.png", dpi=300)
plt.close()

print("Generated high-resolution diagnostic plots successfully.")
EOF

echo "All RF shielding evaluations and post-processing completed successfully."
ls -lh outputs/

DR_LAB_EOF
bash -euo pipefail user_script.sh

stage "Done"
echo "[INFO] finished $(date -u +%FT%TZ)"
ls -la outputs
